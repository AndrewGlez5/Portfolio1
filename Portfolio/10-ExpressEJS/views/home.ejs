<%- include('partials/top') %>

<p>Logged in with <%= authType %> method.</p>
<ul>
    <% if (!entries || entries.length === 0) { %>
        <li>No articles are available at the moment.</li>
    <% } else { %>
        <% entries.forEach((entry, index) => { %>
            <li>
                <h3><%= entry.heading %></h3>
                <p><%= entry.text.length > 100 ? entry.text.substring(0, 100) + '...' : entry.text %></p>
                <a href="/article/<%= index %>">Read more</a>
            </li>
        <% }) %>
    <% } %>
</ul>

<h3>Submit a New Article</h3>

<form action="/submitEntry" method="post">
    <div>
        <label for="heading">Article Title:</label>
        <input type="text" id="heading" name="heading" required>
    </div>

    <label for="text">Article Content:</label>

    <div>
        <textarea id="text" name="text" rows="8" cols="50" placeholder="Type your content here..." required></textarea>
        <button type="submit">Post Article</button>
    </div>
</form>

<%- include('partials/bottom') %>