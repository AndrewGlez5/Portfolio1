<%- include('partials/top') %>
<h3>Remove Article</h3>
<form action="/removeArticle/<%= articleId %>" method="post">
    <button type="submit" onclick="return confirm('Are you sure you want to remove this article?');">Delete Article</button>
</form>

<h3>Update Article</h3>

<form action="/updateArticle/<%= articleId %>" method="post">
    <div>
        <label for="heading">Article Title:</label>
        <input type="text" id="heading" name="heading" value="<%= article.heading %>" required>
    </div>
    <label for="body">Article Content:</label>
    <div>
        <textarea id="body" name="body" rows="8" cols="50"><%= article.body %></textarea>
        <button type="submit">Apply Changes</button>
    </div>
</form>

<a href="/dashboard">Return to Dashboard</a>

<%- include('partials/bottom') %>
